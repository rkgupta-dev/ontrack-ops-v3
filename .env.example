# v2 backend (glacier) — the only backend Login/Attendance talk to in Phase 1.
# Legacy (api.on-track.in) uses static Basic auth and is not wired up yet;
# add VITE_API_BASE_LEGACY here when a module that needs it is built.
VITE_API_BASE_V2=https://glacier.on-track.in/api

# Google Geocoding API key, used to reverse-geocode punch in/out coordinates
# into a human-readable place name (see docs/api-reference.md A-069).
# Restrict this key to the Geocoding API in the Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging — same "ontrack-notification" project the old
# app (operationsapp-frontend) uses, per user decision (2026-09-07) to
# reuse it rather than stand up a separate project. Values are the old
# app's src/firebase.js config (Firebase web config values are not secret —
# they're restricted by Firebase security rules, not confidentiality — but
# still live in env vars here rather than hardcoded, per this project's
# convention). Login gracefully sends deviceToken: null if these are blank.
VITE_FIREBASE_API_KEY=AIzaSyBDhHqIEdXXs6NxFgFucnVnqqLjItA1fBY
VITE_FIREBASE_AUTH_DOMAIN=ontrack-notification.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ontrack-notification
VITE_FIREBASE_STORAGE_BUCKET=ontrack-notification.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=44016478849
VITE_FIREBASE_APP_ID=1:44016478849:web:4d85406735348dc20ffb80
# VAPID key (Cloud Messaging > Web configuration > Web Push certificates in
# the Firebase console) — NOT present in the old app's config (it used the
# older Firebase v8 compat SDK, which didn't require it). The modern v9+
# SDK this app uses does. Get it from the Firebase console; until it's set,
# getDeviceToken() returns null and login sends deviceToken: null as before.
VITE_FIREBASE_VAPID_KEY=
